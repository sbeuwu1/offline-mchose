<Window x:Class="MchoseHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:MchoseHub.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MchoseHub"
        mc:Ignorable="d"
        Title="Offline Mchose" 
        Height="880" Width="1300"
        MinHeight="700" MinWidth="1050"
        Icon="Assets/app_icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Mode Button Style -->
        <Style x:Key="ModeCardButton" TargetType="Button">
            <Setter Property="Background" Value="#170E2F"/>
            <Setter Property="BorderBrush" Value="#2E1A5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rate Button Style -->
        <Style x:Key="RateButton" TargetType="Button">
            <Setter Property="Background" Value="#170E2F"/>
            <Setter Property="BorderBrush" Value="#2E1A5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Slider Style -->
        <Style x:Key="CyberSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Segmented Button Style -->
        <Style x:Key="SegButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="CyberToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="24">
                            <Border x:Name="Bg" Background="#1F133D" CornerRadius="12" BorderBrush="#3B2275" BorderThickness="1"/>
                            <Ellipse x:Name="Dot" Width="18" Height="18" Fill="#A1A1AA" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#0A0614"/>
                                <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Dot" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Navbar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Navigation Bar -->
        <Border Grid.Row="0" Background="#0F081F" BorderBrush="#251447" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Group -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Padding="10,5" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#C084FC" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="MCHOSE" FontWeight="Black" FontSize="14" Foreground="#0A0614"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Offline Mchose" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrushText}"/>
                            <!-- Crisp Neon Purple Credit Badge (Zero Blur) -->
                            <Border Margin="10,0,0,0" Background="#240D4A" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                    UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="by " FontSize="11" FontWeight="Medium" Foreground="#C084FC" VerticalAlignment="Center"/>
                                    <TextBlock Text="rapou7" FontSize="11" FontWeight="ExtraBold" Foreground="#FAF5FF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Mw_Subtitle}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions & Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Top Fullscreen Tester Launcher Button -->
                    <Button Content="{loc:Tr Mw_TesterButton}" Click="BtnLaunchTester_Click" ToolTip="{loc:Tr Mw_TesterTooltip}"
                            Background="#2E1A5E" Foreground="#C084FC"
                            FontWeight="Bold" FontSize="12" Padding="14,7" Cursor="Hand" BorderThickness="0" Margin="0,0,12,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Status Pill -->
                    <Border Background="#170E2F" BorderBrush="#2E1A5E" BorderThickness="1" CornerRadius="20" Padding="14,5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="statusDot" Width="8" Height="8" Fill="#EF4444" Margin="0,0,8,0"/>
                            <TextBlock x:Name="statusText" Text="{loc:Tr Status_Disconnected}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                            <TextBlock x:Name="batteryBadge" Text="" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="8,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Connect / Disconnect Button -->
                    <Button x:Name="btnConnect" Content="{loc:Tr Btn_Connect}" Click="BtnConnect_Click"
                            Background="{StaticResource BrushPrimary}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                            Padding="16,7" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14">
            <Grid MaxWidth="1280" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <!-- Upper Row: 2 Balanced Columns for Controls -->
                    <RowDefinition Height="Auto"/>
                    <!-- Lower Row: Full-Width Hardware Packet Monitor -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============================================== -->
                <!-- UPPER SECTION: 2 COLUMNS (CONTROLS & SETTINGS) -->
                <!-- ============================================== -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <!-- Left Column: Device, Modes, Polling, Power -->
                        <ColumnDefinition Width="*" MinWidth="460"/>
                        <ColumnDefinition Width="16"/>
                        <!-- Right Column: DPI Stages, Sensor Tuning -->
                        <ColumnDefinition Width="*" MinWidth="500"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel Grid.Column="0">

                        <!-- 1. Connected Device Hero Card -->
                        <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Mouse Render Image -->
                                <Border Grid.Column="0" Width="68" Height="84" Background="#120B24" CornerRadius="10" BorderBrush="#2E1A5E" BorderThickness="1" Padding="4" Margin="0,0,14,0">
                                    <Image Source="pack://application:,,,/Assets/A7V2Pro_black.png" Stretch="Uniform">
                                        <Image.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/>
                                        </Image.Effect>
                                    </Image>
                                </Border>

                                <!-- Device Specs & Identifiers -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock x:Name="heroDeviceName" Text="MCHOSE A7 V2 Ultra / Pro" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushText}" Margin="0,0,8,0"/>
                                        <Border Background="#2E1A5E" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="heroVidPid" Text="VID: 0x3837 • PID: 0x100B" FontFamily="Consolas, monospace" FontSize="10" Foreground="{StaticResource BrushAccent}"/>
                                        </Border>
                                    </StackPanel>
                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock Text="PAW3950 Ultra" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Tr Hero_UpToHz}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Tr Hero_UpToDpi}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Real-time Battery Status Card -->
                                <Border Grid.Column="2" Background="#120B24" BorderBrush="#2E1A5E" BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="{loc:Tr Hero_Battery}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock x:Name="heroBatteryText" Text="--%" FontSize="18" FontWeight="Black" FontFamily="Consolas, monospace" Foreground="{StaticResource BrushAccent}" Margin="0,0,6,0"/>
                                            <Border Width="30" Height="16" BorderBrush="#3B2275" BorderThickness="1.5" CornerRadius="3" Padding="2" VerticalAlignment="Center">
                                                <Grid>
                                                    <Border x:Name="heroBatteryFill" Width="0" HorizontalAlignment="Left" Background="{StaticResource BrushAccent}" CornerRadius="1.5"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 2. Performance Modes Card (Tightened Header & Clean Spacing) -->
                        <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Mode_Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{loc:Tr Mode_Subtitle}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#1E293B" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="activeModeBadge" Text="{loc:Tr Mode_Gaming}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                                    </Border>
                                </Grid>

                                <!-- 3 Mode Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="btnMode1" Grid.Column="0" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="1">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{loc:Tr Mode_Performance}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr Mode_PerformanceSub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnMode2" Grid.Column="2" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{loc:Tr Mode_Gaming}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr Mode_GamingSub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnMode3" Grid.Column="4" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="3">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{loc:Tr Mode_Extreme}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr Mode_ExtremeSub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="modeDescText" Text="{loc:Tr Mode_Desc_Gaming}"
                                           FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. Polling Rate Card (Tightened Header & Clean Spacing) -->
                        <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Rate_Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{loc:Tr Rate_Subtitle}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#1E293B" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="activeHzBadge" Text="{loc:Tr Rate_BadgeDefault}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                                    </Border>
                                </Grid>

                                <!-- 6 Polling Rates Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="btnRate0" Grid.Column="0" Style="{StaticResource RateButton}" Click="BtnRate_Click" Tag="0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="125" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr Unit_Hz}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnRate1" Grid.Column="2" Style="{StaticResource RateButton}" Click="BtnRate_Click" Tag="1">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="500" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr Unit_Hz}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnRate2" Grid.Column="4" Style="{StaticResource RateButton}" Click="BtnRate_Click" Tag="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="1000" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr Unit_Hz}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnRate3" Grid.Column="6" Style="{StaticResource RateButton}" Click="BtnRate_Click" Tag="3">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="2000" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr Unit_Hz}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnRate4" Grid.Column="8" Style="{StaticResource RateButton}" Click="BtnRate_Click" Tag="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="4000" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr Unit_Hz}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnRate5" Grid.Column="10" Style="{StaticResource RateButton}" Click="BtnRate_Click" Tag="5">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="8000" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="8K" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Debounce & Power Management Card -->
                        <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Power_Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>
                                <TextBlock Text="{loc:Tr Power_Subtitle}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Key Debounce -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Tr Power_Debounce}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{loc:Tr Power_DebounceSub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,1,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="sliderDebounce" Grid.Column="0" Minimum="1" Maximum="20" Value="8" SmallChange="1"
                                                    Style="{StaticResource CyberSlider}" ValueChanged="SliderDebounce_ValueChanged"/>
                                            <TextBlock x:Name="txtDebounceVal" Grid.Column="1" Text="{loc:Tr Power_DebounceDefault}" Width="38" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Sleep Timer -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Tr Power_Sleep}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{loc:Tr Power_SleepSub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,1,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="sliderSleep" Grid.Column="0" Minimum="1" Maximum="60" Value="3" SmallChange="1"
                                                    Style="{StaticResource CyberSlider}" ValueChanged="SliderSleep_ValueChanged"/>
                                            <TextBlock x:Name="txtSleepVal" Grid.Column="1" Text="{loc:Tr Power_SleepDefault}" Width="32" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="chkNeverSleep" Grid.Column="2" Content="{loc:Tr Power_Never}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" Click="ChkNeverSleep_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- RIGHT COLUMN -->
                    <StackPanel Grid.Column="2">

                        <!-- 1. DPI Stages & Sensitivity Card -->
                        <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Dpi_Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{loc:Tr Dpi_Subtitle}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Dpi_Levels}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Border Background="#131B2E" BorderBrush="#25334D" BorderThickness="1" CornerRadius="8" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="btnLvl1" Content="1" Style="{StaticResource SegButton}" Click="BtnLevelCount_Click" Tag="1"/>
                                                <Button x:Name="btnLvl2" Content="2" Style="{StaticResource SegButton}" Click="BtnLevelCount_Click" Tag="2"/>
                                                <Button x:Name="btnLvl3" Content="3" Style="{StaticResource SegButton}" Click="BtnLevelCount_Click" Tag="3"/>
                                                <Button x:Name="btnLvl4" Content="4" Style="{StaticResource SegButton}" Click="BtnLevelCount_Click" Tag="4"/>
                                                <Button x:Name="btnLvl5" Content="5" Style="{StaticResource SegButton}" Click="BtnLevelCount_Click" Tag="5" Background="{StaticResource BrushAccent}" Foreground="#000000"/>
                                                <Button x:Name="btnLvl6" Content="6" Style="{StaticResource SegButton}" Click="BtnLevelCount_Click" Tag="6"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1E293B" CornerRadius="6" Padding="8,3" Margin="8,0,0,0">
                                            <TextBlock x:Name="activeDpiBadge" Text="{loc:Tr Dpi_StageDefault}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Dynamic DPI Stages Container -->
                                <StackPanel x:Name="dpiStagesContainer" Margin="0,0,0,10">
                                    <!-- Populated dynamically in code-behind -->
                                </StackPanel>

                                <!-- Save DPI Button -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnSaveDpi" Content="{loc:Tr Dpi_Save}" Click="BtnSaveDpi_Click"
                                            Background="{StaticResource BrushPrimary}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                            Padding="16,6" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Sensor & Motion Tuning Card -->
                        <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Sensor_Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>
                                <TextBlock Text="{loc:Tr Sensor_Subtitle}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10"/>

                                <!-- Lift-Off Distance (LOD) with Spaced Buttons -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Sensor_Lod}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{loc:Tr Sensor_LodSub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#120B24" BorderBrush="#2E1A5E" BorderThickness="1" CornerRadius="8" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="btnLod0" Content="{loc:Tr Sensor_Lod07}" Style="{StaticResource SegButton}" Click="BtnLod_Click" Tag="0" MinWidth="68" Padding="14,6" Margin="0,0,6,0"/>
                                            <Button x:Name="btnLod1" Content="{loc:Tr Sensor_Lod10}" Style="{StaticResource SegButton}" Click="BtnLod_Click" Tag="1" MinWidth="68" Padding="14,6" Margin="0,0,6,0" Background="{StaticResource BrushAccent}" Foreground="#000000"/>
                                            <Button x:Name="btnLod2" Content="{loc:Tr Sensor_Lod20}" Style="{StaticResource SegButton}" Click="BtnLod_Click" Tag="2" MinWidth="68" Padding="14,6"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Separator Background="#1E293B" Margin="0,0,0,10"/>

                                <!-- Motion Sync -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Sensor_MotionSync}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{loc:Tr Sensor_MotionSyncSub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="toggleMotionSync" Style="{StaticResource CyberToggleSwitch}" HorizontalAlignment="Right" Click="SensorToggle_Changed"/>
                                </Grid>

                                <Separator Background="#1E293B" Margin="0,0,0,10"/>

                                <!-- Ripple Control -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Sensor_Ripple}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{loc:Tr Sensor_RippleSub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="toggleRipple" Style="{StaticResource CyberToggleSwitch}" HorizontalAlignment="Right" Click="SensorToggle_Changed"/>
                                </Grid>

                                <Separator Background="#1E293B" Margin="0,0,0,10"/>

                                <!-- Angle Snapping -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Sensor_Angle}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{loc:Tr Sensor_AngleSub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="toggleAngleSnap" Style="{StaticResource CyberToggleSwitch}" HorizontalAlignment="Right" Click="SensorToggle_Changed"/>
                                </Grid>

                                <Separator Background="#1E293B" Margin="0,0,0,10"/>

                                <!-- Sensor Angle (Rotate) -->
                                <Grid Margin="0,0,0,2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Sensor_Rotate}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{loc:Tr Sensor_RotateSub}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider x:Name="sliderRotate" Width="110" Minimum="-30" Maximum="30" SmallChange="1" LargeChange="5" Value="0"
                                                Style="{StaticResource CyberSlider}" ValueChanged="SliderRotate_ValueChanged" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="txtRotateVal" Text="{loc:Tr Sensor_RotateDefault}" Width="35" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                        <Button Content="{loc:Tr Sensor_RotateReset}" Click="BtnResetRotate_Click" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0"
                                                FontSize="10" Padding="8,3" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

                <!-- ======================================================== -->
                <!-- LOWER SECTION: FULL HORIZONTAL SPACE PACKET MONITOR LOGS -->
                <!-- ======================================================== -->
                <Border Grid.Row="1" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Log_Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:Tr Log_Subtitle}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="{loc:Tr Log_Clear}" Click="BtnClearLog_Click" Background="#2E1A5E" Foreground="{StaticResource BrushTextMuted}" BorderThickness="0"
                                    FontSize="11" Padding="12,4" HorizontalAlignment="Right" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Full Horizontal Space Terminal Console -->
                        <Border Background="#090412" BorderBrush="#251447" BorderThickness="1" CornerRadius="8" Padding="10" Height="145">
                            <ScrollViewer x:Name="logScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="logItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" Foreground="{Binding ColorHex}" FontFamily="Consolas, Courier New, monospace" FontSize="11" Margin="0,1" TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
